<Page
    x:Class="Mirador.App.Pages.LighthousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style
            x:Key="CardCommand"
            BasedOn="{StaticResource SubtleButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="16" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Lighthouse" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.BluetoothMissing, Mode=OneWay}"
                Message="This PC has no Bluetooth, so Mirador can't switch base stations."
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.BluetoothOff, Mode=OneWay}"
                Message="Bluetooth is off. Turn it on to find and switch base stations."
                Severity="Warning"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}">
                <InfoBar.ActionButton>
                    <Button Click="OnBluetoothSettings" Content="Bluetooth settings" />
                </InfoBar.ActionButton>
            </InfoBar>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSaveProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveProblem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

            <TextBlock Style="{StaticResource FirstSectionHeader}" Text="Base stations" />
            <Grid Margin="1,0,0,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Text="Select which base stations Mirador controls"
                    TextWrapping="Wrap" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        Margin="0,0,4,0"
                        IsActive="{x:Bind ViewModel.IsLooking, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.ScanCommand}" Content="Scan" />
                    <Button Command="{x:Bind ViewModel.SwitchOnCommand}" Content="On" />
                    <Button Command="{x:Bind ViewModel.SwitchOffCommand}" Content="Off" />
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{x:Bind ViewModel.Stations}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:StationItem">
                        <toolkit:SettingsCard ContentAlignment="Vertical" HorizontalContentAlignment="Stretch">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    MinWidth="0"
                                    Margin="2,0,12,0"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}"
                                    IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind AddressLine, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StateLine, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Identify"
                                    Visibility="{x:Bind IsV2, Mode=OneWay}">
                                    <Button
                                        AutomationProperties.HelpText="{x:Bind IdentifyHelp, Mode=OneWay}"
                                        AutomationProperties.Name="Identify"
                                        Click="{x:Bind Identify}"
                                        IsEnabled="{x:Bind CanIdentify, Mode=OneWay}"
                                        Style="{StaticResource CardCommand}">
                                        <FontIcon Glyph="&#xE890;" />
                                    </Button>
                                </Grid>
                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="More options"
                                    Click="OnMore"
                                    Style="{StaticResource CardCommand}"
                                    ToolTipService.ToolTip="More options">
                                    <FontIcon Glyph="&#xE712;" />
                                </Button>
                            </Grid>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Margin="1,4,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No base stations found yet. They show up here when they're plugged in and in Bluetooth range."
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasNoStations, Mode=OneWay}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="Room setup" />
            <TextBlock
                Margin="1,0,0,4"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.RoomSetupUnavailable, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.HasRoomSetupUnavailable, Mode=OneWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasMissingRoomSetup, Mode=OneWay}"
                Message="{x:Bind ViewModel.MissingRoomSetup, Mode=OneWay}"
                Severity="Warning"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasChangedRoomSetup, Mode=OneWay}"
                Message="{x:Bind ViewModel.ChangedRoomSetup, Mode=OneWay}"
                Severity="Warning"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <TextBlock
                Margin="1,0,0,4"
                Text="{x:Bind vm:LighthouseViewModel.RoomSetupRestartNote}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.RoomSetupStopsMonado, Mode=OneWay}" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasRoomSetupMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.RoomSetupMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.RoomSetupSeverity, Mode=OneWay}"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <toolkit:SettingsCard Description="Lay all connected controllers on the floor." Header="Floor">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing
                        Width="20"
                        Height="20"
                        IsActive="{x:Bind ViewModel.RoomSetupBusy, Mode=OneWay}" />
                    <Button Command="{x:Bind ViewModel.MeasureFloorCommand}" Content="Measure floor" />
                </StackPanel>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="Look straight ahead." Header="Forward">
                <Button Command="{x:Bind ViewModel.SetForwardCommand}" Content="Set forward" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Export to SteamVR">
                <Button
                    Click="OnExportToSteamVr"
                    Content="Export"
                    IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}" />
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Settings" />
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSettingsProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.SettingsProblem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <toolkit:SettingsCard Header="Power base stations off when Monado stops">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PowerOffAtMonadoStop, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Power base stations on when Mirador starts">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PowerOnAtMiradorStart, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Power base stations off when Mirador quits">
                <ToggleSwitch IsOn="{x:Bind ViewModel.PowerOffAtMiradorQuit, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Turn off controllers and trackers when Monado stops">
                <ToggleSwitch IsOn="{x:Bind ViewModel.ControllersOffAtMonadoStop, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard
                Description="{x:Bind ViewModel.SteamVrButtonStartDescription}"
                Header="Block SteamVR from auto-starting when a controller turns on"
                IsEnabled="{x:Bind ViewModel.CanStopSteamVrButtonStart}">
                <ToggleSwitch x:Name="SteamVrButtonStartSwitch" IsOn="{x:Bind ViewModel.SteamVrButtonStartStopped, Mode=OneWay}" Toggled="OnSteamVrButtonStartToggled" />
            </toolkit:SettingsCard>
            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSteamVrButtonStartProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.SteamVrButtonStartProblem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
            <toolkit:SettingsCard Description="When Relevant: only while Mirador uses them. (Recommended)" Header="Station state tracking rate">
                <ComboBox MinWidth="200" SelectedIndex="{x:Bind ViewModel.StationState, Mode=TwoWay}">
                    <ComboBoxItem Content="Constant" />
                    <ComboBoxItem Content="When Relevant" />
                </ComboBox>
            </toolkit:SettingsCard>
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
