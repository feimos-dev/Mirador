<Page
    x:Class="Mirador.App.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:vm="using:Mirador.App.ViewModels">

    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitle}" Text="App settings" />

            <InfoBar
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasProblem, Mode=OneWay}"
                Message="{x:Bind ViewModel.Problem, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

            <TextBlock Style="{StaticResource FirstSectionHeader}" Text="General" />
            <toolkit:SettingsCard Header="Start Mirador when you sign in">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartAtSignIn, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Start Mirador when a game needs Monado">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartMiradorForGames, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Start minimized" IsEnabled="{x:Bind ViewModel.StartAtSignIn, Mode=OneWay}">
                <ToggleSwitch IsOn="{x:Bind ViewModel.StartMinimized, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Close to the tray">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CloseToTray, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Minimize to the tray">
                <ToggleSwitch IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Automatically Check for Updates">
                <ToggleSwitch IsOn="{x:Bind ViewModel.CheckForUpdates, Mode=TwoWay}" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Description="{x:Bind ViewModel.UpdatesText, Mode=OneWay}" Header="Updates">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.Checking, Mode=OneWay}" />
                    <HyperlinkButton
                        Content="Release notes"
                        NavigateUri="{x:Bind ViewModel.MiradorReleaseUrl, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasMiradorRelease, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button
                        Command="{x:Bind ViewModel.UpdateOpenCompositeCommand}"
                        Content="Update OpenLamina"
                        Visibility="{x:Bind ViewModel.CanUpdateOpenComposite, Mode=OneWay, Converter={StaticResource VisibleWhenTrue}}" />
                    <Button Command="{x:Bind ViewModel.CheckNowCommand}" Content="Check now" />
                </StackPanel>
            </toolkit:SettingsCard>

            <TextBlock Style="{StaticResource SectionHeader}" Text="Monado folder" />
            <toolkit:SettingsExpander
                Description="{x:Bind Folder.Description}"
                Header="Backups"
                IsExpanded="True"
                ItemsSource="{x:Bind Folder.Backups}">
                <Button Click="OnImport" Content="Import…" />
                <toolkit:SettingsExpander.ItemTemplate>
                    <DataTemplate x:DataType="vm:FolderBackupItem">
                        <toolkit:SettingsCard Header="{x:Bind Text}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="OnRestore" Content="Restore" />
                                <Button Click="OnExport" Content="Export…" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                    </DataTemplate>
                </toolkit:SettingsExpander.ItemTemplate>
                <toolkit:SettingsExpander.ItemsFooter>
                    <toolkit:SettingsCard
                        Header="No backups yet"
                        Visibility="{x:Bind Folder.HasNoBackups, Mode=OneWay}" />
                </toolkit:SettingsExpander.ItemsFooter>
            </toolkit:SettingsExpander>
            <InfoBar
                Closed="OnFolderMessageClosed"
                IsClosable="True"
                IsOpen="{x:Bind Folder.HasMessage, Mode=OneWay}"
                Message="{x:Bind Folder.Message, Mode=OneWay}"
                Severity="{x:Bind Folder.Severity, Mode=OneWay}"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />

            <TextBlock Style="{StaticResource SectionHeader}" Text="About" />
            <toolkit:SettingsCard Description="Boost Software License 1.0" Header="{x:Bind ViewModel.Version}">
                <HyperlinkButton Content="github.com/feimos-dev/Mirador" NavigateUri="https://github.com/feimos-dev/Mirador" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="{x:Bind ViewModel.BundledMonadoVersion}" />
            <toolkit:SettingsCard Description="{x:Bind ViewModel.OpenCompositeDescription, Mode=OneWay}" Header="OpenLamina">
                <HyperlinkButton Content="github.com/feimos-dev/OpenLamina" NavigateUri="https://github.com/feimos-dev/OpenLamina" />
            </toolkit:SettingsCard>
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
