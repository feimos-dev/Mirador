<Page
    x:Class="Mirador.App.Pages.EyeTrackingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Mirador.App.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <c:PageColumn>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Style="{StaticResource PageTitle}" Text="Eye tracking" />

            <TextBlock Style="{StaticResource FirstSectionHeader}" Text="Headset" />
            <toolkit:SettingsCard Description="{x:Bind ViewModel.VariantDescription, Mode=OneWay}" Header="Headset variant">
                <!-- Below 700 wide the ComboBox goes under the text (the toolkit's default is 476), so the description keeps its width. -->
                <toolkit:SettingsCard.Resources>
                    <x:Double x:Key="SettingsCardWrapThreshold">700</x:Double>
                </toolkit:SettingsCard.Resources>
                <ComboBox
                    MinWidth="200"
                    ItemsSource="{x:Bind ViewModel.Variants}"
                    SelectedItem="{x:Bind ViewModel.SelectedVariant, Mode=TwoWay, Converter={StaticResource ProfileConverter}}" />
            </toolkit:SettingsCard>

            <InfoBar
                Closed="OnMessageClosed"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="Error"
                Visibility="{Binding IsOpen, RelativeSource={RelativeSource Mode=Self}, Converter={StaticResource VisibleWhenTrue}}" />
        </StackPanel>
        </c:PageColumn>
    </ScrollViewer>
</Page>
